PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/tatamotors-ev
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=8h
# Customer signup; public accounts never receive staff/admin access.
ALLOW_PUBLIC_REGISTRATION=true
FRONTEND_URLS=http://localhost:3000

# n8n Phase 1 automation (all event types can share one workflow URL)
N8N_AUTOMATION_WEBHOOK_URL=http://localhost:5678/webhook/tataev-automation
N8N_BOOKING_WEBHOOK_URL=
N8N_LEAD_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=replace_with_a_webhook_signing_secret
BOOKING_ADMIN_EMAIL=owner@example.com

# Optional AI and EV data providers
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
EV_API_KEY=
# Readable official manufacturer pages for chat context. No API key needed.
EV_LIVE_WEB_ENABLED=true

# Razorpay Subscriptions — keep every secret in backend/.env only.
# Start with Test Mode keys and test plan IDs. Never commit real values.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Use a separate random webhook secret with at least 32 characters.
RAZORPAY_WEBHOOK_SECRET=
# Create NEW Razorpay plans at the amounts in docs/RAZORPAY_SETUP.md.
RAZORPAY_PLAN_STARTER_MONTHLY=
RAZORPAY_PLAN_STARTER_ANNUAL=
RAZORPAY_PLAN_GROWTH_MONTHLY=
RAZORPAY_PLAN_GROWTH_ANNUAL=
RAZORPAY_PLAN_ENTERPRISE_MONTHLY=
RAZORPAY_PLAN_ENTERPRISE_ANNUAL=
# Optional public billing help contact (include country code); set only in .env.
# This is NOT a UPI ID or settlement destination. Empty hides the contact link.
PAYMENT_SUPPORT_PHONE=
